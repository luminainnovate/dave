# =============================================================================
# br.ai.n Router Node Configuration (Raspberry Pi)
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Router Settings ---
ROUTER_PORT=8001
ROUTER_MODEL=qwen2.5:1.5b
ROUTER_OLLAMA_URL=http://localhost:11434
ROUTER_CTX=4096

# --- Desktop (Expert Node) ---
# The desktop's LAN IP address.
DESKTOP_IP=localiphere
DESKTOP_PORT=8000

# --- Desktop Waker Service ---
# The existing desktop-waker.service on this Pi (main.py).
# Used to send WoL magic packets via its /wake-desktop endpoint.
WAKER_URL=http://localhost:8000
# The secret token required by the waker service's x-auth-token header.
WAKER_TOKEN=your-secret-token-here

# --- Desktop Remote Startup (SSH) ---
# After WoL, the router SSHes into the desktop to start the orchestrator.
# Requires passwordless SSH: ssh-copy-id user@ip
DESKTOP_SSH_USER=usernamehere
DESKTOP_SSH_HOST=localiphere
# Path to br.ai.n on the desktop (where start_desktop.sh lives).
DESKTOP_WORKSPACE_DIR=/path/to/br.ai.n

# --- Wake-on-LAN Timing ---
# Seconds to wait for the OS to boot after sending WoL.
WOL_BOOT_WAIT=35
# Seconds to poll /health after SSH startup (orchestrator loading time).
WOL_HEALTH_TIMEOUT=90
# How often to poll during the health timeout (seconds).
WOL_POLL_INTERVAL=5

# --- Optional: Kill Desktop GUI on Wake ---
# If true, stops GDM3 via the waker service to free ~2.5GB VRAM.
# Only enable if the desktop is headless during AI use.
KILL_GUI_ON_WAKE=false

# --- Triage Tuning ---
# Queries with complexity above this threshold are forwarded to the desktop expert.
# Range: 1-10. Lower = more queries go to expert. Higher = more handled locally.
COMPLEXITY_THRESHOLD=6
